<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil de Cores</title>
    <link rel="stylesheet" href="/styles/cim-theme.css">
    
</head>
<body class="cim-page">

    <main class="cim-shell cim-shell-narrow">
        <header class="cim-header">
            <div>
                <h1 class="cim-title">Perfil de Cores do Item <strong><%= perfilcores[0].codigo_item %></strong></h1>
                <p class="cim-subtitle">Sequencia tecnica de cores da producao</p>
            </div>
        </header>
        
        <div class="cim-table-wrapper">
            <table class="cim-table">
                <thead>
                    <tr>
                        <th>Seq. Cor</th>
                        <th>Cor</th>
                        <th>Anilox</th>
                        <th>Densidade</th>
                        <th>TV - 25/50/75</th>
                        <th>LAB</th>
                    </tr>
                </thead>
                <tbody>
                    <% perfilcores.forEach(function(perfilcores) { 
                        let cor; 
                        if (perfilcores.seq_cor === 1) cor = "#2ce4e9"
                        if (perfilcores.seq_cor === 2) cor = "#d351ae"
                        if (perfilcores.seq_cor === 3) cor = "#f3e81ce0"
                        if (perfilcores.seq_cor === 4) cor = "#080808"
                        if (perfilcores.seq_cor === 5) cor = "#db9049"
                        if (perfilcores.seq_cor === 6) cor = "#51d376"
                        if (perfilcores.seq_cor === 7) cor = "#9251d3"
                        if (perfilcores.seq_cor === 8) cor = "#a5dfd3"
                        if (perfilcores.seq_cor === 9) cor = "#9e007e"
                        if (perfilcores.seq_cor === 10) cor = "#00b1ac"
                        %>
                        <tr>
                            <td class="td-cor" data-label="Seq. Cor" style="background-color:<%=cor%>;"><%=perfilcores.seq_cor%></td>
                            <td class="td-cor" data-label="Cor" style="background-color:<%=cor%>;"><%=perfilcores.desc_cor%></td>
                            <td class="td-cor" data-label="Anilox" style="background-color:<%=cor%>;"><%=perfilcores.anilox%></td>
                            <td class="td-cor" data-label="Densidade" style="background-color:<%=cor%>;"><%=perfilcores.densidade%></td>
                            <td class="td-cor" data-label="TV - 25/50/75" style="background-color:<%=cor%>;"><%=perfilcores.tv%></td>
                            <td class="td-cor" data-label="LAB" style="background-color:<%=cor%>;"><%=perfilcores.lab%></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <p class="cim-footer">Perfil de Cores - CIM</p> 
    </main>    
        <script>
        </script>
</body>

</html>
