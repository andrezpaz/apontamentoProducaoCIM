<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Componentes da OP</title>
  <link rel="stylesheet" href="/styles/cim-theme.css">
</head>
<body class="cim-page">
  <main class="cim-shell">
    <header class="cim-header">
      <div>
        <h1 class="cim-title">Componentes da OP <strong><%= componentes_op[0].op %></strong></h1>
        <p class="cim-subtitle">Materiais programados e enderecos disponiveis</p>
      </div>
    </header>

  <div class="cim-table-wrapper">
    <table class="cim-table tableComponentes">
      <thead>
        <tr>
          <th>OP Componente</th>
          <th>Etapa</th>
          <th>Recurso</th>
          <th>Componente</th>
          <th>Saldo KG</th>
          <th>Saldo QTD</th>
          <th>Unidade</th>
          <th>Tipo Material</th>
        </tr>
      </thead>
      <tbody>
        <% componentes_op.forEach(function(componentes) { %>
          <tr>
            <td class="td-cor" data-label="OP Componente"><%= componentes.op_componente %></td>
            <td class="td-cor" data-label="Etapa"><%= componentes.etapa %></td>
            <td class="td-cor" data-label="Recurso"><%= componentes.recurso %></td>
            <td class="td-cor" data-label="Componente"><%= componentes.componente %></td>
            <td class="td-cor" data-label="Saldo KG"><%= componentes.saldo_peso %></td>
            <td class="td-cor" data-label="Saldo QTD"><%= componentes.saldo_qtd %></td>
            <td class="td-cor" data-label="Unidade"><%= componentes.unidade %></td>
            <td class="td-cor" data-label="Tipo Material"><%= componentes.tipo_componente %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="cim-table-wrapper">
    <table class="cim-table tableEnderecos">
      <thead>
        <tr>
          <th>Tipo Material</th>
          <th>Pallet</th>
          <th>Endereço</th>
          <th>Situação</th>
        </tr>
      </thead>
      <tbody>
        <% enderecosVolumesPallet.forEach(function(pallets) { 
            let palletConsumido = pallets.SITUACAO === 'Consumo Interno';
          %>
          <tr class="<%= palletConsumido ? 'linha-consumida' : '' %>">
            <td class="td-cor" data-label="Tipo Material"><%= pallets.TIPO_MATERIAL %></td>
            <td class="td-cor" data-label="Pallet"><%= pallets.PALLET %></td>
            <td class="td-cor" data-label="Endereco"><%= pallets.ENDERECO %></td>
            <td class="td-cor" data-label="Situacao">
              <%= pallets.SITUACAO %>
              <% if (palletConsumido) { %>
                <span class="cim-badge cim-badge-muted">Consumido</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <p class="cim-footer">Componentes da OP - CIM</p>
  </main>
</body>
</html>
