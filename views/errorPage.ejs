<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fila Producao</title>
    <link rel="stylesheet" href="/styles/cim-theme.css">
    
</head>
<body class="cim-page cim-page-center">
    <main class="cim-empty">
        <h1 class="cim-empty-title">
            <%=msg%>
        </h1>
        <p class="cim-subtitle">A pagina sera atualizada automaticamente.</p>
    </main> 
<script>
    setInterval(() => {
        window.location.reload(true); // força reload total a cada minuto
        }, 60000); // 60.000 ms = 1 minuto
</script>
</body>
</html>
