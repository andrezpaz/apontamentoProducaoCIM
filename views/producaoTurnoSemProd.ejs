<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produção da OP</title>
    <link rel="stylesheet" href="/styles/cim-theme.css">
</head>

<body class="cim-page">
    <%
    let corFundoTotal = '#ff4d4d' // vermelho vivo
    %>

    <main class="cim-shell">
    <header class="cim-header">
        <div>
            <h1 class="cim-title">Recurso <strong><%= recurso %></strong></h1>
            <p class="cim-subtitle">Indicador de producao do turno atual</p>
        </div>
        <div id="relogio" class="cim-clock"></div>
    </header>

    <div class="cim-grid">
        <section class="cim-panel">
            <h2 id="titleMetragemTurno" class="cim-metric cim-metric-danger">Sem Produção</h2>
            <p class="cim-footer">Indicador de Produção - CIM</p>
        </section>
    
    <% if (recurso) { %>
      <!-- Coluna direita: iframe -->
    <aside class="cim-panel">
        <br>
        <div id="dados-maquinas"></div>
        <br>
        <iframe 
        src="http://autoflex.bazei.com.br:7000/openDashboardAutoflexFilter.html?token=fi3oo8knu5&filtro=<%=filtroAutoflex%>"
        class="cim-iframe" frameborder="1">
        </iframe>
    </aside>
    <% } %>
    </div>
    </main>
    
    <script src="/socket.io/socket.io.js"></script>
    <script src="/scripts/painelAutoflexApi.js"></script>
    <script>
        function atualizarRelogio() {
            const agora = new Date();
            const horas = agora.getHours().toString().padStart(2, '0');
            const minutos = agora.getMinutes().toString().padStart(2, '0');
            const segundos = agora.getSeconds().toString().padStart(2, '0');
            const horario = `${horas}:${minutos}:${segundos}`;
            document.getElementById('relogio').textContent = horario;
        }

        setInterval(atualizarRelogio, 1000);
        atualizarRelogio(); // chama uma vez imediatamente
    </script>

    <script>
        setInterval(() => {
        window.location.reload(true); // força reload total a cada minuto
        }, 120000); // 120.000 ms = 2 minutos
    </script>
</body>
</html>
