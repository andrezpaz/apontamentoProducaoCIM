<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produção da OP</title>
    <link rel="stylesheet" href="/styles/cim-theme.css">
    <style>
        .producao-op-metric small {
            font-size: inherit;
            line-height: 1.15;
        }

        .producao-op-table th,
        .producao-op-table td {
            text-align: center;
        }

        @media (max-width: 640px) {
            .producao-op-table td {
                align-items: center;
                text-align: center;
            }
        }
    </style>
    
</head>
<body class="cim-page">

    <main class="cim-shell cim-shell-narrow">
        <header class="cim-header">
            <div>
                <h1 class="cim-title">OP <strong><%=producao[0].OP %></strong></h1>
                <p class="cim-subtitle">Resumo de producao e entregas</p>
            </div>
        </header>

        <section class="cim-metric producao-op-metric">
            Produção Total
            <small>KG: <%=producao[0].TOTALPRODUZIDOPESO.toLocaleString('pt-BR') %></small>
            <small>QTD: <%=producao[0].TOTALPRODUZIDOQTD.toLocaleString('pt-BR') %></small>
        </section>

            <div class="cim-table-wrapper">
            <table class="cim-table producao-op-table">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Entrega</th>
                        <th>Qtd Entrega</th>
                        <th>Un do Item</th>
                    </tr>
                </thead>
                <tbody>
                    <% entregasOP.forEach(function(entrega) { 
                        %>
                        <tr>
                            <td class="td-cor" data-label="Pedido"><%=entrega.PEDIDO%></td>
                            <td class="td-cor" data-label="Entrega"><%=entrega.SEQ_ENTREGA%></td>
                            <td class="td-cor" data-label="Qtd Entrega"><%=entrega.QUANTIDADE.toLocaleString('pt-BR')%></td>
                            <td class="td-cor" data-label="Un do Item"><%=entrega.UNIDADE%></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            </div>

            <div class="cim-table-wrapper">
            <table class="cim-table producao-op-table">
                <thead>
                    <tr>
                        <th>Taras Utilizadas</th>
                    </tr>
                </thead>
                <tbody>
                    <% tarasOP.forEach(function(tara) { 
                        %>
                        <tr>
                            <td class="td-cor" data-label="Taras Utilizadas"><%=tara.TARAS.toLocaleString('pt-BR',{minimumFractionDigits: 2, maximumFractionDigits: 2})%></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            </div>

            <p class="cim-footer">Produções da OP - CIM</p> 
    </main>    
        <script>
        </script>
</body>

</html>
