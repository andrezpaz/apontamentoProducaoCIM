<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fila Produção - <%=maquina[0].recurso%></title>
    <link rel="stylesheet" href="/styles/cim-theme.css">
    <link rel="stylesheet" href="/styles/fila.css">

</head>
<body>
    <div style="display: none;" class="containerIframe" id ="containerIframe">
    <button class="buttonIframeClose" onclick="closeIFrame(this);">X</button><br>
    </div>

    <div style="display:none;" class="containerIframe" id ="containerIframeComponentes">
        <button class="buttonIframeClose" onclick="closeIFrame(this);">X</button><br>
    </div>

    <div style="display:none;" class="containerIframe" id ="containerIframeRelProducao">
        <button class="buttonIframeClose" onclick="closeIFrame(this);">X</button><br>
    </div>

    <div id="loadingOverlay" class="loading-overlay">
        <div class="loading-spinner"></div>
    </div>
    <div style="display: none;" class="containerIframeOP" id ="containerIframeOP">
        <button class="buttonIframeClose" onclick="closeIFrame(this);">X</button><br>
    </div>

    <div style="display: none;" class="containerIframeChecklist" id ="containerIframeChecklist">
        <button class="buttonIframeClose" onclick="closeIFrame(this);">X</button><br>
    </div>

    <div style="display: none;" class="containerIframeError" id ="containerIframeError">
        <button class="buttonIframeClose" onclick="closeIFrame(this);">X</button><br>
    </div>

    <main class="pageFila">
        <header class="filaHeader">
            <div>
                <div class="filaTitle">
                    <div class="filaSelectGroup filaSelectGroupHero">
                        <label for="selectRecursoFila">Recurso</label>
                        <select id="selectRecursoFila" class="selectFila selectFilaHero codRecurso"></select>
                    </div>
                    <div class="filaSelectGroup filaSelectGroupHero">
                        <label for="selectEtapaFila">Etapa</label>
                        <select id="selectEtapaFila" class="selectFila selectFilaHero codEtapa"></select>
                    </div>
                    <% if (listarInterrompidas) { %>
                        <a class="buttonModeFila buttonModeFilaActive" href="/fila/<%=maquina[0].recurso%>">Listar Fila/Producao</a>
                    <% } else { %>
                        <a class="buttonModeFila" href="/fila/<%=maquina[0].recurso%>?situacao=T">OPs Interrompidas</a>
                    <% } %>
                </div>
                <p class="filaSubtitle"><%= listarInterrompidas ? 'OPs interrompidas do recurso' : 'Fila de producao CIM' %></p>
            </div>
            <div class="filaHeaderActions">
                <button class="buttonRefreshFila" onclick="document.location.reload(true)">
                    <img class="imgRefreshFila" src="/images/RefreshArrow.png" alt="">
                    Atualizar
                </button>
            </div>
        </header>

        <div class="tableWrap">
            <table class="tableFila">
                <thead>
                    <tr>
                        <th class="hide-mobile">Seq.</th>
                        <th>OP</th>
                        <th>Ini Prog.</th>
                        <th class="hide-mobile">Fim Prog.</th>
                        <th>Peso OP.</th>
                        <th>Qtd. OP</th>
                        <th>Item</th>
                        <th class="hide-mobile">Descricao Item</th>
                        <% if ( !maquina[0].etapa.toString().startsWith('1')) { %>
                            <th class="hide-mobile">Entrega</th>
                            <th class="hide-mobile">Cores</th>
                            <% if ( maquina[0].recurso.toString().startsWith("2") ){ %>
                                <th class="hide-mobile">Velocidade</th>
                            <% } %>
                            <th class="hide-mobile">Imagem</th>
                            <% if ( maquina[0].recurso.toString().startsWith("2") ) {%>
                                <th class="hide-mobile">Perfil</th>
                            <% } %>
                            <th>Componentes</th>
                        <% } %>
                        <th>Acoes</th>
                    </tr>
                </thead>
                <tbody>
                    <%
                    let velocidade_item;
                    maquina.forEach(function(maquina)
                    {
                        let tipoAvisoOp = Number(maquina.tipo_aviso_op || 0);
                        let textoAvisoOp = '';
                        if (tipoAvisoOp == 1) {
                            textoAvisoOp = 'Produto Novo';
                        }
                        if (tipoAvisoOp == 2) {
                            textoAvisoOp = 'Reclamação de Cliente';
                        }
                        let fraseColunaComponentes = '';
                        if (maquina.componente_bob_extrusada) {
                            fraseColunaComponentes = 'Qtd Extrusada: ' + maquina.saldo_componentes;
                        }
                        if (maquina.componente_bob_terceiro) {
                            fraseColunaComponentes = 'Bob Terceiro Disponivel';
                        }
                    %>
                        <tr class="linha-op aviso-op-<%=tipoAvisoOp%>">
                            <td class="seqFila hide-mobile" data-label="Seq.">
                                <% if (maquina.codigo_cor_mrp !== null) { %>
                                    <span class="mrpMarker" style="background-color: <%=maquina.codigo_cor_mrp%>;"><%=maquina.seq_fila%></span>
                                <% } else { %>
                                    <%=maquina.seq_fila%>
                                <% } %>
                            </td>

                            <td class="opCell" data-label="OP">
                                <div class="opContent">
                                <% if (maquina.situacao_recurso === 'P') { %>
                                    <strong class="numero_op"><%=maquina.op%></strong>
                                    <img src="/images/iconRelProdOP.png" class="iconRelProdOP" onclick="openIframe(this)" title="Relatorio de producao" alt="Relatorio de producao">
                                    <span class="statusBadge">Em Prod.</span>
                                <% } else if (maquina.situacao_recurso === 'T') { %>
                                    <strong class="numero_op"><%=maquina.op%></strong>
                                    <span class="statusBadge statusBadgeInterrompida">Interrompida</span>
                                <% } else { %>
                                    <strong class="numero_op"><%=maquina.op%></strong>
                                <% } %>
                                <% if (textoAvisoOp) { %>
                                    <span class="avisoBadge avisoBadge-<%=tipoAvisoOp%>"><%=textoAvisoOp%></span>
                                <% } %>
                                </div>
                            </td>

                            <td class="codigo_etapa"><%=maquina.etapa%></td>
                            <td data-label="Ini Prog."><%=functions.dateFormat("custom",maquina.inicioprog)%></td>
                            <td class="hide-mobile" data-label="Fim Prog."><%=functions.dateFormat("custom",maquina.fimprog)%></td>
                            <td data-label="Peso OP."><%=maquina.peso.toLocaleString('pt-BR')%></td>
                            <td data-label="Qtd. OP"><%=maquina.quantidade.toLocaleString('pt-BR')%></td>
                            <td class="codigo_item itemCode" name="codigo_item" data-label="Item"><%=maquina.codigo_item%></td>
                            <td class="itemDescription hide-mobile" data-label="Descricao"><%=maquina.descricao_item%></td>

                            <% if ( !maquina.etapa.toString().startsWith('1')) { %>
                                <td class="hide-mobile" data-label="Entrega"><%=maquina.previsoes_entregas%></td>
                                <td class="hide-mobile" data-label="Cores"><%=maquina.quantidade_cores%></td>
                                <% if ( maquina.recurso.toString().startsWith("2") ){
                                    velocidade_item = maquina.velocidade_item ? maquina.velocidade_item.slice(0,3):''; %>
                                    <td class="hide-mobile" data-label="Velocidade"><span class="speedBadge"><%=velocidade_item%></span></td>
                                <% } %>

                                <td class="hide-mobile" data-label="Imagem">
                                    <div class="imageActions">
                                        <% if (maquina.TIPO_IMAGEM) {
                                            maquina.TIPO_IMAGEM.forEach(function(tipo_imagem){
                                            let codItemTipoImg = tipo_imagem.codigo_item + '-' + tipo_imagem.descricao_tipo_imagem.charAt(0); %>
                                                <button class="buttonImagem"><a target="_blank" href="/images/itens/<%=codItemTipoImg%>"><%=tipo_imagem.descricao_tipo_imagem%></a></button>
                                        <%  })
                                        } %>
                                    </div>
                                </td>

                                <% if (maquina.recurso.toString().startsWith("2")) { %>
                                    <td class="hide-mobile" data-label="Perfil">
                                        <% if ( maquina.tem_perfil > 0 ) {%>
                                            <img src="/images/iconView.png" class="iconPerfil" onclick="openIframe(this)" title="Perfil de cores" alt="Perfil de cores">
                                        <% } %>
                                    </td>
                                <%  } %>

                                <% if (!maquina.componente_op_negativo) {%>
                                    <td data-label="Componentes">
                                        <strong class="componentesOP componentBadge" onclick="openIframe(this)"><%=fraseColunaComponentes%></strong>
                                    </td>
                                <% } %>
                                <% if (maquina.componente_op_negativo) {%>
                                    <td class="gradiente-animado" data-label="Componentes">
                                        <strong class="componentesOP componentBadge" onclick="openIframe(this)">INDISPONIVEL</strong>
                                    </td>
                                <% } %>
                            <% } %>

                            <td data-label="Acoes">
                                <div class="rowActions">
                                    <img src="/images/iconOP.png" class="iconOP" onclick="openIframe(this)" title="Gerar OP" alt="Gerar OP">
                                    <% if ( maquina.etapa.toString().startsWith('1') || maquina.etapa.toString().startsWith('3') ) { %>
                                        <img src="/images/iconConsumo.png" class="iconConsumo" onclick="openIframe(this)" title="Consumo" alt="Consumo">
                                        <img src="/images/iconChecklist.png" class="iconChecklist hide-mobile" onclick="openIframe(this)" title="Checklist" alt="Checklist">
                                    <%} else { %>
                                        <img src="/images/iconChecklist.png" class="iconChecklist" onclick="openIframe(this)" title="Checklist" alt="Checklist">
                                    <%}%>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>

        <p class="filaFooter">Fila de producao CIM</p>
    </main>
        <script>
            const opcoesFila = <%- JSON.stringify(opcoesFila || []).replace(/</g, '\\u003c') %>;
            const listarInterrompidas = <%= listarInterrompidas ? 'true' : 'false' %>;

            function normalizaOpcaoFila(opcao) {
                return {
                    etapa: String(opcao.etapa || opcao.ETAPA || ''),
                    recurso: String(opcao.recurso || opcao.RECURSO || '')
                };
            }

            function ordenarNumericoTexto(a, b) {
                return a.localeCompare(b, 'pt-BR', { numeric: true });
            }

            function inicializarSeletoresFila() {
                const selectEtapa = document.getElementById('selectEtapaFila');
                const selectRecurso = document.getElementById('selectRecursoFila');
                if (!selectEtapa || !selectRecurso) return;

                const etapaAtual = '<%=maquina[0].etapa%>';
                const recursoAtual = '<%=maquina[0].recurso%>';
                const opcoes = opcoesFila.map(normalizaOpcaoFila).filter(opcao => opcao.etapa && opcao.recurso);

                if (!opcoes.some(opcao => opcao.etapa === etapaAtual && opcao.recurso === recursoAtual)) {
                    opcoes.push({ etapa: etapaAtual, recurso: recursoAtual });
                }

                const etapas = [...new Set(opcoes.map(opcao => opcao.etapa))].sort(ordenarNumericoTexto);

                selectEtapa.innerHTML = etapas.map(etapa =>
                    `<option value="${etapa}" ${etapa === etapaAtual ? 'selected' : ''}>${etapa}</option>`
                ).join('');

                function carregarRecursos(etapaSelecionada, recursoPreferido) {
                    const recursos = [...new Set(
                        opcoes
                            .filter(opcao => opcao.etapa === etapaSelecionada)
                            .map(opcao => opcao.recurso)
                    )].sort(ordenarNumericoTexto);

                    const placeholder = '<option value="">Selecione o recurso</option>';
                    selectRecurso.innerHTML = placeholder + recursos.map(recurso =>
                        `<option value="${recurso}" ${recurso === recursoPreferido ? 'selected' : ''}>${recurso}</option>`
                    ).join('');
                }

                carregarRecursos(selectEtapa.value || etapaAtual, recursoAtual);

                selectEtapa.addEventListener('change', () => {
                    carregarRecursos(selectEtapa.value, '');
                });

                selectRecurso.addEventListener('change', () => {
                    if (selectRecurso.value && selectRecurso.value !== recursoAtual) {
                        const querySituacao = listarInterrompidas ? '?situacao=T' : '';
                        window.location.href = `/fila/${encodeURIComponent(selectRecurso.value)}${querySituacao}`;
                    }
                });
            }

            inicializarSeletoresFila();

            async function gerarOP(op, etapa, seqEtapa, recurso) {
                const params = {
                    op: op,
                    etapa: etapa,
                    seqEtapa: seqEtapa,
                    recurso: recurso
                }
                document.getElementById('loadingOverlay').style.display = 'flex';
                try {
                    const response = await fetch('/gerarOP', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(params)
                    });
                    const data = await response.json();
                    document.getElementById('loadingOverlay').style.display = 'none';
                    return data.fileURL
                } catch (error) {
                    console.log('Erro ao requisitar a geração de OP', error);
                    document.getElementById('loadingOverlay').style.display = 'none';
                }
            }
            async function gerarUrlComponentes(op, etapa, recurso) {
                document.getElementById('loadingOverlay').style.display = 'flex';
                try {
                    const url = `/componentes/${op}/${etapa}/${recurso}`
                    return url
                } catch (error) {
                    console.log('Erro ao requisitar a geração Relatório de componentes da OP', error);
                    document.getElementById('loadingOverlay').style.display = 'none';
                }
            }
            async function gerarRelProducaoOP(op, etapa) {
                const params = {
                    op: op,
                    etapa: etapa
                }
                document.getElementById('loadingOverlay').style.display = 'flex';
                try {
                    const url = `/gerarRelProducaoOP?op=${op}&etapa=${etapa}`
                    return url
                } catch (error) {
                    console.log('Erro ao requisitar a geração Relatório de Produção da OP', error);
                    document.getElementById('loadingOverlay').style.display = 'none';
                }
            }
            async function getUrlChecklist(op, etapa, recurso) {
                const params = {
                    op: op,
                    etapa: etapa,
                    recurso: recurso
                }
                document.getElementById('loadingOverlay').style.display = 'flex';
                try {
                    const response = await fetch('/getUrlChecklist', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(params)
                    });
                    const data = await response.json();
                    document.getElementById('loadingOverlay').style.display = 'none';
                    return data.urlChecklist
                } catch (error) {
                    console.log('Erro ao requisitar a geração da URL do Checklist ', error);
                    document.getElementById('loadingOverlay').style.display = 'none';
                }
            }
            async function getUrlConsumo(op, etapa, recurso) {
                const params = {
                    op: op,
                    etapa: etapa,
                    recurso: recurso
                }
                document.getElementById('loadingOverlay').style.display = 'flex';
                try {
                    const response = await fetch('/getUrlConsumo', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(params)
                   });
                    const data = await response.json();
                    document.getElementById('loadingOverlay').style.display = 'none';
                    return data.urlConsumo;
                } catch (error) {
                    console.log('Erro ao requisitar a geração da URL do Consumo de compnente ', error);
                    document.getElementById('loadingOverlay').style.display = 'none';
                }
            }
            async function openIframe(element) {
                function getElementValue(selector) {
                    const target = document.querySelector(selector);
                    if (!target) return '';
                    return (target.value || target.textContent || target.innerHTML || '').trim();
                }

                function executeIfrmae(idContainer, idElement, src) {
                    const container = document.getElementById(idContainer);
                    // Limpa o conteúdo anterior (remove iframe antigo, se houver)
                    container.innerHTML = `
                        <button class="buttonIframeClose" onclick="closeIFrame(this);">X</button><br>
                    `;

                    // Cria novo iframe dinamicamente
                    const iframe = document.createElement('iframe');
                    iframe.id = idElement;
                    iframe.width = '100%';
                    iframe.height = '100%';
                    iframe.src = src;
                    iframe.onload = function () {
                        document.getElementById('loadingOverlay').style.display = 'none';
                    };

                    // Adiciona ao container
                    container.appendChild(iframe);
                    container.style.display = 'block';

                }
                let elementParent = element.closest('tr');

                let codigo_item = elementParent.querySelector('.codigo_item').innerHTML;
                let numeroOP = elementParent.querySelector('.numero_op').innerHTML;
                let codEtapa = elementParent.querySelector('.codigo_etapa').innerHTML;
                let codRecurso = getElementValue('.codRecurso');
                let className = element.classList;
                if (className.contains('iconPerfil')) {
                    executeIfrmae("containerIframe", "iframePerfil", `/perfilcores/${codigo_item}`)
                }
                if (className.contains('componentesOP')) {
                    let urlComponentes = await gerarUrlComponentes(numeroOP, codEtapa, codRecurso);
                    if (urlComponentes) {
                        executeIfrmae("containerIframeComponentes", "iframeComponentesOP", urlComponentes)
                    }
                    else {
                        executeIfrmae("containerIframeError", "iframeError")
                    }
                }
                if (className.contains('iconOP')) {
                    let urlOP = await gerarOP(numeroOP, codEtapa, 1, codRecurso);
                    if (urlOP) {
                        window.open(urlOP, '_blank')
                    } else {
                        executeIfrmae("containerIframeError", "iframeError")
                    }
                }
                if (className.contains('iconRelProdOP')) {
                    let urlProducao = await gerarRelProducaoOP(numeroOP, codEtapa);
                    if (urlProducao) {
                        executeIfrmae("containerIframeRelProducao", "iframeRelProducao", urlProducao)                        
                    } else {
                        executeIfrmae("containerIframeError", "iframeError")
                    }
                }
                if (className.contains('iconChecklist')) {
                    let urlChecklist = await getUrlChecklist(numeroOP, codEtapa, codRecurso)
                    if (urlChecklist) {
                        window.open(urlChecklist, '_blank')
                    } else {
                        executeIfrmae("containerIframeError", "iframeError")
                    }
                }
                if (className.contains('iconConsumo')) {
                    let urlConsumo = await getUrlConsumo(numeroOP, codEtapa, codRecurso)
                    if (urlConsumo) {
                        window.open(urlConsumo, '_self')
                    } else {
                        executeIfrmae("containerIframeError", "iframeError")
                    }
                }

                history.replaceState(null, null, location.href);
            }
            function closeIFrame(element) {
                const container = element.parentElement;
                container.style.display = "none";
                container.innerHTML = ''; // remove o conteúdo, inclusive o iframe
            }
        </script>
</body>

</html>
